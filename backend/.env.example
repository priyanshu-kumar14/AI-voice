# Production configuration
HOST=0.0.0.0
PORT=8000
# Comma-separated browser origins, with no trailing slash.
CORS_ORIGINS=http://localhost:3000
# Mount or copy the reference WAV into the backend container/host.
REFERENCE_VOICE_PATH=/app/reference_voice.wav
F5_TTS_DEVICE=cpu
MAX_TEXT_CHARACTERS=5000
MAX_BATCH_CHARACTERS=500
